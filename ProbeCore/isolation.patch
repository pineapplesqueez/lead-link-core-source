+// InstanceDialer keeps a probe's DNS and outbound chains out of process globals.
+// Created before core construction and bound before handlers start.
+type InstanceDialer struct {
+	sync.RWMutex
+	dns       dns.Client
+	outbounds outbound.Manager
+	owner     context.Context
+}
+type instanceDialerKey struct{}
+
+func NewInstanceDialer(ctx context.Context) *InstanceDialer { return &InstanceDialer{owner: ctx} }
+func (s *InstanceDialer) Bind(dc dns.Client, om outbound.Manager) {
+	s.Lock()
+	defer s.Unlock()
+	s.dns = dc
+	s.outbounds = om
+}
+func (s *InstanceDialer) Owner() context.Context { return s.owner }
+func InstanceDialerFromContext(ctx context.Context) *InstanceDialer {
+	state, _ := ctx.Value(instanceDialerKey{}).(*InstanceDialer)
+	return state
+}
+func ContextWithInstanceDialer(ctx context.Context, state *InstanceDialer) context.Context {
+	if state == nil {
+		return ctx
+	}
+	return context.WithValue(ctx, instanceDialerKey{}, state)
+}
+func CopyInstanceDialer(dst, src context.Context) context.Context {
+	return ContextWithInstanceDialer(dst, InstanceDialerFromContext(src))
+}
+func dialerFeatures(ctx context.Context) (dns.Client, outbound.Manager) {
+	if s := InstanceDialerFromContext(ctx); s != nil {
+		s.RLock()
+		defer s.RUnlock()
+		return s.dns, s.outbounds
+	}
+	return dnsClient, obm
+}
+func LookupForIPContext(ctx context.Context, domain string, strategy DomainStrategy, localAddr net.Address) ([]net.IP, error) {
+	dc, _ := dialerFeatures(ctx)
+	return lookupForIP(dc, domain, strategy, localAddr)
+}
+
 func InitSystemDialer(dc dns.Client, om outbound.Manager) {
 	dnsClient = dc
 	obm = om
